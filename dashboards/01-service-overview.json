    {
      "type": "stat",
      "title": "Fleet RPS (sum, last 5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-observability"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-observability"
          },
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_namespace=\"ecom\"}[5m])) + sum(rate(http_server_request_duration_seconds_count{service_name=\"payment-gateway\"}[5m]))",
          "legendFormat": "rps"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Fleet error ratio (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-observability"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 4,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-observability"
          },
          "expr": "((sum(rate(http_server_request_duration_seconds_count{service_namespace=\"ecom\",http_response_status_code=~\"5..\"}[5m])) or (0 * sum(rate(http_server_request_duration_seconds_count{service_namespace=\"ecom\"}[5m])))) + (sum(rate(http_server_request_duration_seconds_count{service_name=\"payment-gateway\",http_response_status_code=~\"5..\"}[5m])) or (0 * sum(rate(http_server_request_duration_seconds_count{service_name=\"payment-gateway\"}[5m]))))) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service_namespace=\"ecom\"}[5m])) + sum(rate(http_server_request_duration_seconds_count{service_name=\"payment-gateway\"}[5m])), 1e-9)",
          "legendFormat": "error_ratio"
        }
      ]
    },
    {
      "type": "row",
      "title": "Per-Service Status",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
