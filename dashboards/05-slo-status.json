      "id": 11,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "alertmanager",
            "uid": "alertmanager-observability"
          },
          "expr": "ALERTS{alertstate=\"firing\",severity=~\"page|ticket\"}",
          "legendFormat": "{{alertname}}",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Starts at",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto",
              "wrapText": false
            },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
